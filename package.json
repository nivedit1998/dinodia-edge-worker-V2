  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.63.0"
  }
}
